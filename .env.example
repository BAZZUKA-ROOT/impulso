# Copy to .env.local. Everything here is OPTIONAL — the app works with zero keys,
# using the free Pollinations service for image and caption generation.

# If you later swap to a paid/managed provider, add its key here and point the
# adapters in lib/ai/* to it. Examples (not required):
# OPENAI_API_KEY=
# HF_API_TOKEN=
# GROQ_API_KEY=

# Meta Graph API (for real publishing — requires a reviewed Meta app + Business account):
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ACCESS_TOKEN=
